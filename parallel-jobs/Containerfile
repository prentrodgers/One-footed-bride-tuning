# Containerfile — python-music:0.5
# Adds csound, ffmpeg, git, jupyterlab, argon2-cffi relative to 0.4.
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        csound \
        ffmpeg \
        git \
        libstdc++6 \
        libgomp1 \
        libfreetype6 \
        libpng16-16 \
        fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir --prefer-binary -r requirements.txt

# Entrypoint maps JOB_COMPLETION_INDEX -> per-pod args for parallel Jobs.
# When ARG_LIST_FILE is unset the container falls through to bash,
# allowing the Jupyter deployment to override CMD freely.
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
