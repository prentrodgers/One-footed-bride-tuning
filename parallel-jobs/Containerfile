# Containerfile — python-music:0.10
# Adds Cycles-on-the-GPU (oneAPI / Level Zero) for Intel Arc, relative to 0.9
# (which added headless Blender 5.2.0 LTS with Vulkan EEVEE).
#
# EEVEE uses Blender's Vulkan backend (Intel ANV); Cycles uses oneAPI over
# Level Zero. Both talk to a passed-through DRM render node — no Xvfb (that
# gives a software/CPU context). Two things beyond this image are required
# and live in the pod YAML:
#   1. pass the render nodes through (/dev/dri as hostPath, or the individual
#      renderD* CharDevices)
#   2. securityContext.privileged: true on the render container — otherwise
#      the k8s device cgroup denies open() on the node with EPERM and Blender
#      silently falls back to llvmpipe (software). This was THE blocker.
# Node numbers are not stable across hosts or reboots — inside the pod on fs5
# the two B70s were renderD128 and renderD130 and renderD129 was the Arrow
# Lake iGPU (i915, 0x7d67). Select GPUs by identity, not by node: for EEVEE
# MESA_VK_DEVICE_SELECT=8086:e223; for Cycles the device name in the Cycles
# preferences, or ONEAPI_DEVICE_SELECTOR=level_zero:N to pin one card per pod.
# Then render with the vulkan backend:
#   blender --background --gpu-backend vulkan --python blender_stage.py -- \
#       --npy bwv253_features_array.npy --tempo 110 --duration 49.0 \
#       --res-x 1280 --res-y 720 --out stage_frames
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        csound \
        ffmpeg \
        git \
        git-lfs \
        sox \
        libsox-fmt-mp3 \
        libstdc++6 \
        libgomp1 \
        libtbb12 \
        libfreetype6 \
        libpng16-16 \
        fonts-dejavu-core \
        # --- Blender download/unpack + the X libs it links against even when
        #     run headless (loaded at startup regardless of the GL backend) ---
        xz-utils \
        curl \
        ca-certificates \
        libx11-6 libxi6 libxxf86vm1 libxfixes3 libxrender1 \
        libxkbcommon0 libsm6 libxext6 \
        # --- Mesa: iris = OpenGL for Intel Arc/Xe (legacy EEVEE); libgbm1 +
        #     libegl1 are what the headless EGL-surfaceless path needs. This
        #     is all EEVEE needs on the GPU — no Intel compute runtime. ---
        libgl1 libglu1-mesa libglx-mesa0 libgl1-mesa-dri \
        libegl1 libgles2 libgbm1 \
        mesa-vulkan-drivers && \
    rm -rf /var/lib/apt/lists/*

# Battlemage (Arc Pro B-series, PCI 8086:E223, xe KMD) is newer than Debian
# trixie's stock Mesa 25.0.7 — pull Mesa 26.x from trixie-backports so ANV/
# iris recognise and drive the GPU. (Confirmed 26.1.2 available in backports.)
RUN echo 'deb http://deb.debian.org/debian trixie-backports main' \
        > /etc/apt/sources.list.d/backports.list && \
    apt-get update && \
    apt-get install -y -t trixie-backports \
        mesa-vulkan-drivers libgl1-mesa-dri libglx-mesa0 libegl-mesa0 libgbm1 && \
    rm -rf /var/lib/apt/lists/*

# ── Cycles on the GPU: oneAPI / Level Zero ──────────────────────────────────
# Blender 5.2 ships its whole oneAPI side (libsycl, the Level Zero adapter,
# AOT-compiled Cycles kernels, even an OpenImageDenoise SYCL device). What it
# does NOT ship is the system half: the Level Zero LOADER and Intel's GPU
# DRIVER behind it.
#
# Debian trixie provides neither. The driver (intel-compute-runtime) is not
# in the archive under any component — the old note here about contrib and
# non-free was wrong. And trixie's loader, libze1 1.20.6, is too old: it
# lacks zelSetDelayLoaderContextTeardown, which Blender's bundled adapter
# imports, so the adapter fails to load and Cycles silently lists only the
# CPU. (Diagnosed with UR_LOG_LOADER='level:debug;output:stdout'; Level Zero
# itself saw both B70s the whole time.)
#
# So both halves come from Intel's GitHub releases, pinned. The .debs are
# built for Ubuntu 24.04 and install cleanly on trixie (glibc 2.41 >= 2.39).
# Fetched in the build, unlike the Blender tarball: ~105 MB all told, and a
# release-tagged GitHub URL does not drift. Intel's libze1 carries the same
# package name as Debian's, so it upgrades in place and nothing conflicts.
# intel-opencl-icd is not needed by Cycles; it is here so `clinfo -l` can
# confirm the driver sees the cards without involving Blender.
#
# The last piece is Intel's hardware ray-tracing library. Cycles on Arc runs
# Embree on the GPU and refuses to start a oneAPI queue without it
# ("Hardware Raytracing is not available; please install
# intel-level-zero-gpu-raytracing"). It is not in the GitHub releases at all
# — only in Intel's apt repository — so it is fetched straight from that
# repository's pool. It needs libtbb12, which is in the apt list above.
ARG CR_VER=26.31.39395.13
ARG IGC_VER=2.40.13+22418
ARG IGC_TAG=v2.40.13
ARG GMM_VER=22.10.0
ARG ZE_VER=1.32.0
ARG RT_VER=1.1.0-97~u24.04
RUN set -eu && cd /tmp && \
    cr=https://github.com/intel/compute-runtime/releases/download/${CR_VER} && \
    igc=https://github.com/intel/intel-graphics-compiler/releases/download/${IGC_TAG} && \
    ze=https://github.com/oneapi-src/level-zero/releases/download/v${ZE_VER} && \
    rt=https://repositories.intel.com/gpu/ubuntu/pool/unified/i/intel-level-zero-gpu-raytracing && \
    curl -fsSLO ${ze}/libze1_${ZE_VER}+u24.04_amd64.deb && \
    curl -fsSLO ${cr}/libigdgmm12_${GMM_VER}_amd64.deb && \
    curl -fsSLO ${igc}/intel-igc-core-2_${IGC_VER}_amd64.deb && \
    curl -fsSLO ${igc}/intel-igc-opencl-2_${IGC_VER}_amd64.deb && \
    curl -fsSLO ${cr}/libze-intel-gpu1_${CR_VER}-0_amd64.deb && \
    curl -fsSLO ${cr}/intel-opencl-icd_${CR_VER}-0_amd64.deb && \
    curl -fsSLO ${rt}/intel-level-zero-gpu-raytracing_${RT_VER}_amd64.deb && \
    apt-get update && apt-get install -y --no-install-recommends clinfo && \
    dpkg -i ./*.deb && rm -f ./*.deb && ldconfig && \
    rm -rf /var/lib/apt/lists/*

# Blender's AOT kernel set did not cover Battlemage: the first Cycles render
# on a B70 JIT-compiled ~180 MB of kernels — about ten seconds, measured —
# after which it is fast. Keep what it builds. /tmp is per-pod, so a Job
# that wants the cache to outlive the pod points SYCL_CACHE_DIR at the PVC
# in its YAML (render_farm.sh does).
ENV SYCL_CACHE_PERSISTENT=1 \
    SYCL_CACHE_DIR=/tmp/sycl-cache

# Blender 5.2.0 LTS. blender_stage.py picks its EEVEE engine enum at runtime
# (see _pick_eevee_engine), so it tolerates the 5.1->5.2 version difference.
#
# The tarball is COPYied from the build context rather than downloaded during
# the build: downloading a ~350 MB binary mid-build is fragile (mirror 403s,
# URL drift) and non-reproducible. Fetch it ONCE onto the build host first
# (download the Linux x64 .tar.xz from https://www.blender.org/download/ ),
# leaving it in parallel-jobs/. The *.tar.xz is gitignored — it stays local.
COPY blender-5.2.0-linux-x64.tar.xz /tmp/blender.tar.xz
RUN mkdir -p /opt && tar xf /tmp/blender.tar.xz -C /opt && \
    mv /opt/blender-5.2.0-linux-x64 /opt/blender-5.2.0 && \
    ln -s /opt/blender-5.2.0/blender /usr/local/bin/blender && \
    rm -f /tmp/blender.tar.xz && \
    blender --version

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir --prefer-binary -r requirements.txt

# Entrypoint maps JOB_COMPLETION_INDEX -> per-pod args for parallel Jobs.
# When ARG_LIST_FILE is unset the container falls through to bash,
# allowing the Jupyter deployment to override CMD freely.
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
